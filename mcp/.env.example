# URL of the running ProjectRA application (the Next.js service).
PROJECTRA_BASE_URL=http://127.0.0.1:3000

# Local stdio only: a ProjectRA bearer token issued by /api/agent/token.
PROJECTRA_TOKEN=

# Streamable HTTP listener. Keep loopback for local development.
MCP_HOST=127.0.0.1
MCP_PORT=3100

# Comma-separated Host header allow-list for a remote deployment.
# Example: mcp.projectra.example.com
MCP_ALLOWED_HOSTS=
