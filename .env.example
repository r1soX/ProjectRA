# Скопируйте в .env и заполните значения.

# PostgreSQL. Для локальных инструментов (prisma / next dev) — БД из docker
# compose на localhost. Внутри compose-сети приложение использует хост "db".
DATABASE_URL="postgresql://projectra:projectra@localhost:5432/projectra?schema=public"

# Секрет для подписи сессий (JWT). Сгенерируйте свой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Параметры контейнера Postgres (используются docker compose).
POSTGRES_USER=projectra
POSTGRES_PASSWORD=projectra
POSTGRES_DB=projectra

# Встроенный ИИ-помощник Groq. Ключ используется только сервером ProjectRA.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com"

# Необязательно. HTTP(S)-прокси для исходящих запросов ProjectRA к Groq.
# Логин и пароль с особыми символами должны быть percent-encoded.
# Пример: http://user:password@proxy.example.com:3128
GROQ_PROXY_URL=""
GROQ_TIMEOUT_MS=60000
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_MAX_TOOL_ROUNDS=6
PROJECTRA_AI_DEBUG=0
