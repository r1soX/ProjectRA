# Скопируйте в .env и заполните значения.

# PostgreSQL. Для локальных инструментов (prisma / next dev) — БД из docker
# compose на localhost. Внутри compose-сети приложение использует хост "db".
DATABASE_URL="postgresql://projectra:projectra@localhost:5432/projectra?schema=public"

# Секрет для подписи сессий (JWT). Сгенерируйте свой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Параметры контейнера Postgres (используются docker compose).
POSTGRES_USER=projectra
POSTGRES_PASSWORD=projectra
POSTGRES_DB=projectra

# Встроенный ИИ-помощник. Порядок fallback по умолчанию: Cerebras -> Gemini -> Groq.
# Все ключи используются только сервером ProjectRA и не передаются в браузер.
PROJECTRA_AI_PROVIDER="cerebras"
PROJECTRA_AI_PROXY_URL=""
PROJECTRA_AI_HISTORY_MESSAGES=12
PROJECTRA_AI_MAX_COMPLETION_TOKENS=2048
PROJECTRA_AI_MAX_TOOL_ROUNDS=6
PROJECTRA_AI_DEBUG=0

CEREBRAS_API_KEY=""
CEREBRAS_MODEL="gpt-oss-120b"
CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"
CEREBRAS_PROXY_URL=""
CEREBRAS_TIMEOUT_MS=60000

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_PROXY_URL=""
GEMINI_TIMEOUT_MS=60000

# Необязательный третий провайдер. Существующая настройка Groq продолжает работать.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Необязательно. HTTP(S)-прокси для исходящих запросов ProjectRA к Groq.
# Логин и пароль с особыми символами должны быть percent-encoded.
# Пример: http://user:password@proxy.example.com:3128
GROQ_PROXY_URL=""
GROQ_TIMEOUT_MS=60000
# Старые имена сохранены для обратной совместимости; новые установки используют PROJECTRA_AI_*.
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_MAX_TOOL_ROUNDS=6
